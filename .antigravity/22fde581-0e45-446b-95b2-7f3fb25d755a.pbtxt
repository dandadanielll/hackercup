          text: "1. OBJECTIVES:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Identify common modes of transportation used in urban and rural communities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
