        }
        lines {
          text: "2. MOTIVATION SCENARIO:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Every Saturday morning, Mrs. Johnson rides the electric subway to Whole Foods Market. She meets local farmer Robert, who brings fresh peaches and maple syrup from his farm in Vermont via highway cargo trucks. Mrs. Johnson buys 2 kilograms of peaches and 1 bottle of syrup."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
