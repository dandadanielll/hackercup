        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "WARM-UP EXERCISES & WORD PROBLEMS:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Problem 1:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Maria took the subway train to Walmart. At the supermarket, she bought 3 fresh red apples for $2 each and 2 blueberry muffins for $3 each. How much money did Maria spend in total at Walmart?"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Problem 2:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "David boarded the yellow school bus to the downtown subway central station. On his way home, he stopped by Target to buy 4 blue notebooks for $1.50 each and 1 yellow pencil box for $4. How much did David spend before riding the bus home?"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Problem 3:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Teacher Sarah asked the students to count items for a classroom party. Alex bought 5 packages of strawberries from Trader Joe\'s. Each package contains 6 strawberries. How many strawberries does Alex have in total?"
