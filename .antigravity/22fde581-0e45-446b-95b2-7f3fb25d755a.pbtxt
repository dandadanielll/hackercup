<BookOpen className=\"w-3.5 h-3.5 text-emerald-400\" /> PDF / DOCX / TXT\n            </span>\n            <span className=\"text-emerald-700\">|</span>\n            <span className=\"flex items-center gap-1\">\n              <Layers className=\"w-3.5 h-3.5 text-emerald-400\" /> Visual Diff\n            </span>\n          </div>\n\n          {onReset && (\n            <button\n              id=\"reset-btn\"\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-emerald-800 hover:bg-emerald-700 text-emerald-100 transition-colors border border-emerald-700/80 shadow-sm cursor-pointer\"\n              title=\"Reset form and start new document\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" /> Start New\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};"
