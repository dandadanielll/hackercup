      target_content: "export const Header: React.FC<HeaderProps> = ({ onReset }) => {\n  return (\n    <header id=\"main-header\" className=\"bg-emerald-900 text-white border-b border-emerald-800 shadow-md\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row items-center justify-between gap-4\">\n        {/* Brand Logo & Name */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-emerald-500 text-emerald-950 flex items-center justify-center font-black text-xl shadow-inner border border-emerald-300/40\">\n            LS\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-white flex items-center gap-1.5\">\n                LokalSwap\n              </h1>\n              <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-700/80 text-emerald-100 border border-emerald-500/30\">\n                <Sparkles className=\"w-3 h-3 text-emerald-300\" /> DepEd MTB-MLE Contextualizer\n              </span>\n            </div>\n            <p className=\"text-xs text-emerald-200/90 font-normal mt-0.5\">\n              Transform generic lesson plans into relatable regional Philippine classroom scenarios\n            </p>\n          </div>\n        </div>\n\n        {/* Action Controls & Info */}\n        <div className=\"flex items-center gap-2 sm:gap-3\">\n          <div className=\"hidden lg:flex items-center gap-3 text-xs text-emerald-200 bg-emerald-950/40 px-3 py-1.5 rounded-lg border border-emerald-800/60\">\n            <span className=\"flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-emerald-400\" /> 7 Regional Catalogs\n            </span>\n            <span className=\"text-emerald-700\">|</span>\n            <span className=\"flex items-center gap-1\">\n              <BookOpen className=\"w-3.5 h-3.5 text-emerald-400\" /> PDF / DOCX / TXT\n            </span>\n            <span className=\"text-emerald-700\">|</span>\n            <span className=\"flex items-center gap-1\">\n              <Layers className=\"w-3.5 h-3.5 text-emerald-400\" /> Visual Diff\n            </span>\n          </div>\n\n          {onReset && (\n            <button\n              id=\"reset-btn\"\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-emerald-800 hover:bg-emerald-700 text-emerald-100 transition-colors border border-emerald-700/80 shadow-sm cursor-pointer\"\n              title=\"Reset form and start new document\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" /> Start New\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};"
