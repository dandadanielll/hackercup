      target_content: "  return (\n    <div id=\"diff-viewer\" className=\"bg-white rounded-2xl shadow-sm border border-slate-200/90 p-5 sm:p-6 mb-8\">\n      {/* Top Header Bar */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-200\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-1.5 bg-emerald-100 text-emerald-800 rounded-lg\">\n              <Layers className=\"w-4 h-4\" />\n            </div>\n            <h2 className=\"text-base sm:text-lg font-bold text-slate-900\">\n              Cultural Context Diff Review\n            </h2>\n            <span className=\"px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300\">\n              {data.changes.length} {data.changes.length === 1 ? \'Substitution\' : \'Substitutions\'} Applied\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Green highlights mark every replaced cultural entity. Click any green item to edit or customize!\n          </p>\n        </div>\n\n        {/* Category Legend */}\n        <div className=\"flex flex-wrap items-center gap-1.5 text-[11px]\">\n          <span className=\"text-slate-400 font-semibold mr-1\">Legend:</span>\n          {Object.entries(CATEGORY_COLORS).slice(0, 5).map(([cat, style]) => (\n            <span\n              key={cat}\n              className={`px-2 py-0.5 rounded-md font-semibold border ${style.bg} ${style.text} ${style.border}`}\n            >\n              {style.label}\n            </span>\n          ))}\n        </div>\n      </div>\n\n      {/* Side-by-Side Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Left Pane: Original Lesson Plan */}\n        <div className=\"flex flex-col bg-slate-50 rounded-xl border border-slate-200/80 overflow-hidden shadow-2xs\">\n          <div className=\"bg-slate-100/90 px-4 py-2.5 border-b border-slate-200 flex items-center justify-between\">\n            <span className=\"text-xs font-bold text-slate-700 flex items-center gap-1.5\">\n              <span className=\"w-2 h-2 rounded-full bg-slate-400\" />\n              Original Lesson Plan\n            </span>\n            <span className=\"text-[11px] text-slate-500 font-mono\">\n              {data.original.trim().split(/\\s+/).length} words\n            </span>\n          </div>\n          <div className=\"p-4 text-xs font-mono text-slate-700 leading-relaxed whitespace-pre-wrap max-h-[500px] overflow-y-auto selection:bg-slate-200\">\n            {data.original}\n          </div>\n        </div>\n\n        {/* Right Pane: Localized Lesson Plan with Green Highlights */}\n        <div className=\"flex flex-col bg-emerald-50/30 rounded-xl border border-emerald-200 overflow-hidden shadow-2xs relative\">\n          <div className=\"bg-emerald-100/70 px-4 py-2.5 border-b border-emerald-200 flex items-center justify-between\">\n            <span className=\"text-xs font-bold text-emerald-950 flex items-center gap-1.5\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n              Contextualized Regional Version\n            </span>\n            <span className=\"text-[11px] text-emerald-800 font-medium\">\n              Click green tags to edit\n            </span>\n          </div>\n\n          <div className=\"p-4 text-xs font-mono text-slate-900 leading-relaxed whitespace-pre-wrap max-h-[500px] overflow-y-auto selection:bg-emerald-200\">\n            {segments.map((seg) => {\n              if (!seg.isChange) {\n                return <span key={seg.id}>{seg.text}</span>;\n              }\n\n              const catStyle =\n                CATEGORY_COLORS[seg.category || \'other\'] || CATEGORY_COLORS[\'other\'];\n\n              return (\n                <span\n                  key={seg.id}\n                  onClick={() => handleSegmentClick(seg)}\n                  className={`inline-flex items-center gap-1 px-1.5 py-0.5 my-0.5 mx-0.5 rounded font-semibold cursor-pointer transition-all border-b-2 ${catStyle.bg} ${catStyle.text} ${catStyle.border} hover:brightness-95 hover:scale-[1.02] shadow-2xs group relative`}\n                  title={`Original: \"${seg.original}\" \342\206\222 Click to edit`}\n                >\n                  <span>{seg.text}</span>\n                  <Edit3 className=\"w-2.5 h-2.5 opacity-60 group-hover:opacity-100 transition-opacity\" />\n                </span>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* Changes Summary Pill Bar */}\n      <div className=\"mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-2\">\n        <span className=\"text-xs font-bold text-slate-700 flex items-center gap-1\">\n          <Tag className=\"w-3.5 h-3.5 text-emerald-600\" /> Key Substitutions:\n        </span>\n        {data.changes.map((item, idx) => (\n          <div\n            key={idx}\n            className=\"text-[11px] bg-slate-100 text-slate-800 px-2.5 py-1 rounded-md border border-slate-200 flex items-center gap-1\"\n          >\n            <span className=\"text-slate-500 line-through\">{item.original}</span>\n            <ArrowRight className=\"w-2.5 h-2.5 text-emerald-600\" />\n            <span className=\"font-bold text-emerald-900\">{item.replacement}</span>\n          </div>\n        ))}\n      </div>\n\n      {/* Modal / Popover: Click to Edit Substitution */}\n      {editingSegment && (\n        <div className=\"fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-2xs flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-5 animate-in fade-in zoom-in-95 duration-150\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <h3 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n                <Edit3 className=\"w-4 h-4 text-emerald-600\" /> Edit Substitution\n              </h3>\n              <button\n                onClick={() => setEditingSegment(null)}\n                className=\"text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"py-4 space-y-3\">\n              <div>\n                <label className=\"text-[11px] font-bold text-slate-500 block mb-1\">\n                  Original Term in Lesson Plan:\n                </label>\n                <div className=\"p-2 bg-slate-100 text-slate-700 text-xs font-mono rounded-lg border border-slate-200 line-through\">\n                  {editingSegment.original}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-slate-800 block mb-1\">\n                  Regional Substitution (Customizable):\n                </label>\n                <input\n                  type=\"text\"\n                  value={editInputValue}\n                  onChange={(e) => setEditInputValue(e.target.value)}\n                  className=\"w-full p-2.5 text-xs font-mono border border-emerald-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 rounded-lg outline-none\"\n                  placeholder=\"Type new replacement...\"\n                  autoFocus\n                />\n              </div>\n\n              <p className=\"text-[11px] text-slate-500 flex items-center gap-1\">\n                <Info className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n                Updating this will reflect live in both the diff viewer and translation card.\n              </p>\n            </div>\n\n            <div className=\"flex items-center justify-between pt-3 border-t border-slate-100 gap-2\">\n              <button\n                onClick={handleRestoreOriginal}\n                className=\"px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50 rounded-lg transition-colors border border-rose-200 flex items-center gap-1 cursor-pointer\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" /> Revert to Original\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => setEditingSegment(null)}\n                  className=\"px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer\"\n                >\n                  Cancel\n                </button>\n                <button\n                  onClick={handleSaveEdit}\n                  className=\"px-4 py-2 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors flex items-center gap-1 shadow-xs cursor-pointer\"\n                >\n                  <Check className=\"w-3.5 h-3.5\" /> Apply Change\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
