    instruction: "Apply Professional Polish styling to UploadSection component using indigo accent buttons, slate-100 headers, and crisp card borders"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div id=\"upload-section\" className=\"bg-white rounded-2xl shadow-sm border border-slate-200/90 p-5 sm:p-6 mb-8\">\n      {/* Top Banner: Quick Demo Presets */}\n      <div className=\"mb-6 bg-emerald-50/70 rounded-xl p-4 border border-emerald-200/80\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold\">DEMO</span>\n            <h3 className=\"text-sm font-semibold text-emerald-950 flex items-center gap-1.5\">\n              <BookOpen className=\"w-4 h-4 text-emerald-700\" /> Need a sample lesson plan to test instantly?\n            </h3>\n          </div>\n          <span className=\"text-xs text-emerald-700 font-medium\">Click any preset to auto-fill:</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-2.5\">\n          {SAMPLE_LESSONS.map((sample) => (\n            <button\n              key={sample.id}\n              id={`sample-btn-${sample.id}`}\n              onClick={() => handleSampleSelect(sample)}\n              className=\"text-left p-3 rounded-lg bg-white hover:bg-emerald-100/60 border border-emerald-200/90 transition-all shadow-2xs hover:shadow-xs group cursor-pointer\"\n            >\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"text-xs font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded\">\n                  {sample.gradeLevel}\n                </span>\n                <span className=\"text-[11px] text-slate-500 font-medium\">{sample.subject}</span>\n              </div>\n              <div className=\"text-xs font-semibold text-slate-900 group-hover:text-emerald-900 line-clamp-1\">\n                {sample.title}\n              </div>\n              <div className=\"text-[11px] text-slate-500 line-clamp-1 mt-0.5\">\n                {sample.description}\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Main Grid: Upload & Context Controls */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: File Dropzone & Text Area */}\n        <div className=\"lg:col-span-7 flex flex-col gap-4\">\n          <div className=\"flex items-center justify-between\">\n            <label className=\"text-sm font-bold text-slate-800 flex items-center gap-2\">\n              <FileText className=\"w-4 h-4 text-emerald-600\" />\n              Lesson Plan Source Document\n            </label>\n            {fileName && (\n              <span className=\"text-xs font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200 flex items-center gap-1\">\n                <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" /> {fileName}\n              </span>\n            )}\n          </div>\n\n          {/* Drag and Drop Zone */}\n          <div\n            onDragEnter={handleDrag}\n            onDragOver={handleDrag}\n            onLeave={handleDrag}\n            onDrop={handleDrop}\n            onClick={() => fileInputRef.current?.click()}\n            className={`border-2 border-dashed rounded-xl p-5 text-center transition-all cursor-pointer ${\n              dragActive\n                ? \'border-emerald-500 bg-emerald-50/80 scale-[0.99]\'\n                : \'border-slate-300 hover:border-emerald-400 bg-slate-50/60 hover:bg-emerald-50/30\'\n            }`}\n          >\n            <input\n              type=\"file\"\n              ref={fileInputRef}\n              onChange={handleFileChange}\n              accept=\".pdf,.docx,.txt\"\n              className=\"hidden\"\n              id=\"file-input\"\n            />\n            <div className=\"flex flex-col items-center justify-center gap-2\">\n              <div className=\"w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shadow-2xs\">\n                <Upload className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <p className=\"text-xs font-semibold text-slate-800\">\n                  <span className=\"text-emerald-700 underline underline-offset-2\">Click to upload</span> or drag and drop your lesson plan\n                </p>\n                <p className=\"text-[11px] text-slate-500 mt-0.5\">Supports PDF, Word (.docx), or plain text (.txt)</p>\n              </div>\n            </div>\n          </div>\n\n          {extractError && (\n            <div className=\"p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 shrink-0 text-red-500\" />\n              {extractError}\n            </div>\n          )}\n\n          {/* Extracted / Input Textarea */}\n          <div className=\"relative\">\n            <textarea\n              id=\"lesson-text-input\"\n              value={lessonText}\n              onChange={(e) => setLessonText(e.target.value)}\n              placeholder=\"Paste or edit your lesson plan text here...\"\n              rows={9}\n              className=\"w-full p-3.5 text-xs font-mono bg-slate-50 text-slate-900 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all resize-y shadow-inner\"\n            />\n            {isExtracting && (\n              <div className=\"absolute inset-0 bg-white/80 backdrop-blur-2xs rounded-xl flex items-center justify-center gap-2 text-xs font-medium text-emerald-800\">\n                <div className=\"w-4 h-4 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin\" />\n                Extracting text from document...\n              </div>\n            )}\n            <div className=\"flex justify-between items-center text-[11px] text-slate-400 mt-1 px-1\">\n              <span>Characters: {lessonText.length}</span>\n              <span>Words: {lessonText.trim() ? lessonText.trim().split(/\\s+/).length : 0}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Region & Target Language Settings */}\n        <div className=\"lg:col-span-5 flex flex-col justify-between bg-slate-50/80 p-5 rounded-xl border border-slate-200/90 gap-5\">\n          <div className=\"space-y-4\">\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900 flex items-center gap-2 mb-1\">\n                <MapPin className=\"w-4 h-4 text-emerald-600\" /> 1. Select Target Philippine Region\n              </h3>\n              <p className=\"text-xs text-slate-500 mb-2.5\">\n                Swaps foreign entities for regional transport, stores, markets, food, and names.\n              </p>\n\n              <select\n                id=\"region-select\"\n                value={selectedRegionId}\n                onChange={(e) => handleRegionChange(e.target.value)}\n                className=\"w-full p-2.5 bg-white border border-slate-300 text-slate-900 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none shadow-2xs cursor-pointer\"\n              >\n                {PHILIPPINE_REGIONS.map((region) => (\n                  <option key={region.id} value={region.id}>\n                    \360\237\223\215 {region.name} ({region.majorCity}, {region.province})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Selected Region Highlight Box */}\n            <div className=\"p-3 bg-emerald-50/80 border border-emerald-200/80 rounded-lg text-xs space-y-2\">\n              <div className=\"font-semibold text-emerald-950 flex items-center justify-between\">\n                <span>{currentRegion.name} ({currentRegion.majorCity})</span>\n                <span className=\"text-[10px] bg-emerald-200 text-emerald-900 px